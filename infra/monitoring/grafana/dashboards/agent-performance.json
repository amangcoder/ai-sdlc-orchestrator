{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "AI SDLC Orchestrator — agent performance: invocations, success rates, task duration percentiles, and retry rates per agent role.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Run Overview", "url": "/d/run-overview", "type": "link" },
    { "title": "Error Analysis", "url": "/d/error-analysis", "type": "link" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Agent Invocations (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(orchestrator_agent_invocations_total[1h]))",
          "legendFormat": "Invocations",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agent Success Rate (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(orchestrator_agent_invocations_total{status=\"success\"}[1h])) / sum(rate(orchestrator_agent_invocations_total[1h])) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Phase Duration p50 (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(orchestrator_phase_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Retry Rate (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(orchestrator_agent_retries_total[1h])) / sum(rate(orchestrator_agent_invocations_total[1h])) * 100",
          "legendFormat": "Retry %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Agent Invocation Summary (24h)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(orchestrator_agent_invocations_total[24h])) by (agent)",
          "legendFormat": "{{ agent }}",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum(increase(orchestrator_agent_invocations_total{status=\"success\"}[24h])) by (agent) / sum(increase(orchestrator_agent_invocations_total[24h])) by (agent) * 100",
          "legendFormat": "{{ agent }}",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(orchestrator_phase_duration_seconds_bucket[24h])) by (le, phase))",
          "legendFormat": "{{ phase }}",
          "refId": "C",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "displayName", "value": "Success Rate" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 85 },
                    { "color": "green", "value": 95 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "options": {
        "footer": { "show": false }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent Invocations Per Minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(orchestrator_agent_invocations_total[5m])) by (agent) * 60",
          "legendFormat": "{{ agent }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "right" }
      }
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Phase Duration Heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(orchestrator_phase_duration_seconds_bucket[5m])) by (le)",
          "legendFormat": "{{ le }}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Phase Duration Percentiles (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(orchestrator_phase_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(orchestrator_phase_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(orchestrator_phase_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5, "drawStyle": "line" }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["orchestrator", "agents"],
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(orchestrator_agent_invocations_total, agent)",
        "current": { "value": "All", "text": "All" },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Agent Performance",
  "uid": "agent-performance",
  "version": 1
}
