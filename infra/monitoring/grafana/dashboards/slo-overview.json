{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{alertname=~\"PipelineSuccessRateLow|ErrorBudgetExhausted|HighCostBurnRate\", alertstate=\"firing\"}",
        "iconColor": "red",
        "name": "SLO Alerts",
        "step": "60s",
        "titleFormat": "{{ alertname }}"
      }
    ]
  },
  "description": "AI SDLC Orchestrator — SLO compliance matrix with error budget gauges for all 6 service level indicators.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Run Overview", "url": "/d/run-overview", "type": "link" },
    { "title": "Error Analysis", "url": "/d/error-analysis", "type": "link" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## SLO Compliance Matrix\nGreen = passing target | Yellow = at risk (< 30% budget) | Red = breaching SLO"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Pipeline Success Rate",
      "description": "Target: ≥ 95% | SLI: ratio of completed to total runs over 1h",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:pipeline_success_rate:rate1h * 100",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "text": {}
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Phase Duration p95",
      "description": "Target: ≤ 300s | SLI: 95th percentile of all phase durations",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(orchestrator_phase_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Duration",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Avg Cost per Run",
      "description": "Target: ≤ $0.50 | SLI: average cost per run over 24h",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 2 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:cost_per_run_p50:rate24h",
          "legendFormat": "Avg Cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 2.0,
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.35 },
              { "color": "red", "value": 0.50 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Artifact Validation Rate",
      "description": "Target: ≥ 99% | SLI: fraction of artifacts passing schema validation",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:artifact_validation_rate:rate1h * 100",
          "legendFormat": "Validation Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 97 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Error Rate per Run",
      "description": "Target: ≤ 2 errors/run | SLI: average errors per run over 1h",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:error_rate_per_run:rate1h",
          "legendFormat": "Errors/Run",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Recovery Success Rate",
      "description": "Target: ≥ 90% | SLI: fraction of crash recovery attempts that succeed",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(orchestrator_recovery_total{status=\"success\"}[1h])) / sum(rate(orchestrator_recovery_total[1h])) * 100",
          "legendFormat": "Recovery Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Error Budget Remaining (Pipeline Success Rate)",
      "description": "Error budget remaining % — how much failure budget is left before SLO is missed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:error_budget_remaining:pipeline_success_rate * 100",
          "legendFormat": "Budget Remaining",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Success Rate Trend vs SLO Target (1h rolling)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:pipeline_success_rate:rate1h * 100",
          "legendFormat": "Actual Success Rate",
          "refId": "A"
        },
        {
          "expr": "vector(95)",
          "legendFormat": "SLO Target (95%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "drawStyle": "line" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SLO Target (95%)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "dash": [8, 5], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Actual Success Rate" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SLO Violation Timeline",
      "description": "Shows periods where each SLO was violated. 1 = violating, 0 = compliant.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "orchestrator:pipeline_success_rate:rate1h < 0.95",
          "legendFormat": "Success Rate Violation",
          "refId": "A"
        },
        {
          "expr": "orchestrator:phase_duration_p95:5m > 300",
          "legendFormat": "Phase Duration Violation",
          "refId": "B"
        },
        {
          "expr": "orchestrator:error_rate_per_run:rate1h > 2",
          "legendFormat": "Error Rate Violation",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "drawStyle": "bars",
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ],
  "refresh": "60s",
  "schemaVersion": 39,
  "tags": ["orchestrator", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SLO Overview",
  "uid": "slo-overview",
  "version": 1
}
