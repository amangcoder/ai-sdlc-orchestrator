{
  "$defs": {
    "RefactoringStep": {
      "properties": {
        "id": {
          "pattern": "^REFACTOR-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "addresses_debt": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Addresses Debt",
          "type": "array"
        },
        "sequence_order": {
          "minimum": 1,
          "title": "Sequence Order",
          "type": "integer"
        },
        "parallelizable_with": {
          "items": {
            "type": "string"
          },
          "title": "Parallelizable With",
          "type": "array"
        },
        "files_to_modify": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Files To Modify",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "changes": {
          "minLength": 10,
          "title": "Changes",
          "type": "string"
        },
        "postconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Postconditions",
          "type": "array"
        },
        "verification": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification",
          "type": "array"
        },
        "rollback": {
          "minLength": 1,
          "title": "Rollback",
          "type": "string"
        },
        "risk": {
          "pattern": "^(low|medium|high)$",
          "title": "Risk",
          "type": "string"
        },
        "effort": {
          "pattern": "^(hours|days|week)$",
          "title": "Effort",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "addresses_debt",
        "sequence_order",
        "files_to_modify",
        "preconditions",
        "changes",
        "postconditions",
        "verification",
        "rollback",
        "risk",
        "effort"
      ],
      "title": "RefactoringStep",
      "type": "object"
    },
    "SafeStoppingPoint": {
      "properties": {
        "after_step": {
          "minLength": 1,
          "title": "After Step",
          "type": "string"
        },
        "system_state": {
          "minLength": 1,
          "title": "System State",
          "type": "string"
        },
        "value_delivered": {
          "minLength": 1,
          "title": "Value Delivered",
          "type": "string"
        }
      },
      "required": [
        "after_step",
        "system_state",
        "value_delivered"
      ],
      "title": "SafeStoppingPoint",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "minLength": 50,
      "title": "Summary",
      "type": "string"
    },
    "source_debt_items": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Debt Items",
      "type": "array"
    },
    "total_steps": {
      "minimum": 1,
      "title": "Total Steps",
      "type": "integer"
    },
    "estimated_effort": {
      "minLength": 1,
      "title": "Estimated Effort",
      "type": "string"
    },
    "refactoring_steps": {
      "items": {
        "$ref": "#/$defs/RefactoringStep"
      },
      "minItems": 1,
      "title": "Refactoring Steps",
      "type": "array"
    },
    "dependency_graph": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Dependency Graph",
      "type": "object"
    },
    "safe_stopping_points": {
      "items": {
        "$ref": "#/$defs/SafeStoppingPoint"
      },
      "minItems": 1,
      "title": "Safe Stopping Points",
      "type": "array"
    },
    "risks": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Risks",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "source_debt_items",
    "total_steps",
    "estimated_effort",
    "refactoring_steps",
    "safe_stopping_points"
  ],
  "title": "RefactoringPlan",
  "type": "object"
}
