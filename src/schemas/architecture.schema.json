{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture",
  "description": "Architecture document produced by the Architect agent",
  "type": "object",
  "required": ["components", "data_flow", "tech_decisions", "constraints"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "responsibility", "interfaces"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "responsibility": { "type": "string", "minLength": 1 },
          "interfaces": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "data_flow": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 20,
          "description": "Description of how data flows through the system"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "to", "data"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "data": { "type": "string", "minLength": 1 },
              "trigger": { "type": "string" }
            },
            "additionalProperties": false
          },
          "description": "Structured data flow entries"
        }
      ]
    },
    "tech_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision", "rationale"],
        "properties": {
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "alternatives_considered": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "directory_structure": {
      "oneOf": [
        { "$ref": "#/$defs/dir_node" },
        {
          "type": "array",
          "items": { "type": "string" },
          "description": "Flat list of file paths"
        }
      ]
    }
  },
  "$defs": {
    "dir_node": {
      "type": "object",
      "description": "Directory tree — values are either a purpose string or a nested directory object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/$defs/dir_node" }
        ]
      }
    }
  },
  "additionalProperties": false
}
