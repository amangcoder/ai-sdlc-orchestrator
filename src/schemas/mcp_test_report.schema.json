{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCPTestReport",
  "description": "Protocol-level integration test results for an MCP server.",
  "type": "object",
  "required": ["server_name", "transport_tested", "test_cases", "tools_tested", "resources_tested", "protocol_compliance", "verdict"],
  "properties": {
    "server_name": { "type": "string", "minLength": 1 },
    "transport_tested": { "type": "string", "minLength": 1 },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^MCP-TC-\\d+$" },
          "category": {
            "type": "string",
            "enum": ["tool_call", "resource_read", "prompt_get", "transport", "auth", "capability_negotiation", "error_handling", "concurrency"]
          },
          "description": { "type": "string", "minLength": 10 },
          "result": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "details": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tools_tested": { "type": "integer", "minimum": 0 },
    "resources_tested": { "type": "integer", "minimum": 0 },
    "protocol_compliance": { "type": "string", "enum": ["full", "partial", "non_compliant"] },
    "findings": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string", "enum": ["pass", "fail"] }
  },
  "additionalProperties": false
}
