{
  "$defs": {
    "APIConsumerImpact": {
      "properties": {
        "consumer": {
          "minLength": 1,
          "title": "Consumer",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "breaking": {
          "default": false,
          "title": "Breaking",
          "type": "boolean"
        },
        "mitigation": {
          "minLength": 1,
          "title": "Mitigation",
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "endpoint",
        "mitigation"
      ],
      "title": "APIConsumerImpact",
      "type": "object"
    },
    "ChangeSurface": {
      "properties": {
        "module": {
          "minLength": 1,
          "title": "Module",
          "type": "string"
        },
        "change_type": {
          "pattern": "^(breaking_api|schema_migration|interface_change|behavioral_change|additive|config_change)$",
          "title": "Change Type",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "module",
        "change_type",
        "description"
      ],
      "title": "ChangeSurface",
      "type": "object"
    },
    "DownstreamImpact": {
      "properties": {
        "id": {
          "pattern": "^IMPACT-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "affected_module": {
          "minLength": 1,
          "title": "Affected Module",
          "type": "string"
        },
        "risk_level": {
          "pattern": "^(high|medium|low)$",
          "title": "Risk Level",
          "type": "string"
        },
        "impact_type": {
          "pattern": "^(compile_error|runtime_error|behavioral_change|performance|data_integrity)$",
          "title": "Impact Type",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "requires_update": {
          "default": true,
          "title": "Requires Update",
          "type": "boolean"
        },
        "migration_steps": {
          "items": {
            "type": "string"
          },
          "title": "Migration Steps",
          "type": "array"
        }
      },
      "required": [
        "id",
        "affected_module",
        "risk_level",
        "impact_type",
        "description"
      ],
      "title": "DownstreamImpact",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "minLength": 50,
      "title": "Summary",
      "type": "string"
    },
    "overall_risk": {
      "pattern": "^(high|medium|low)$",
      "title": "Overall Risk",
      "type": "string"
    },
    "change_surface": {
      "items": {
        "$ref": "#/$defs/ChangeSurface"
      },
      "minItems": 1,
      "title": "Change Surface",
      "type": "array"
    },
    "downstream_impacts": {
      "items": {
        "$ref": "#/$defs/DownstreamImpact"
      },
      "title": "Downstream Impacts",
      "type": "array"
    },
    "api_consumers_affected": {
      "items": {
        "$ref": "#/$defs/APIConsumerImpact"
      },
      "title": "Api Consumers Affected",
      "type": "array"
    },
    "deployment_constraints": {
      "additionalProperties": true,
      "title": "Deployment Constraints",
      "type": "object"
    },
    "coordination_needed": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Coordination Needed",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "overall_risk",
    "change_surface",
    "recommendations"
  ],
  "title": "ChangeImpactAnalysis",
  "type": "object"
}
