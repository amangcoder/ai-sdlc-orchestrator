{
  "$defs": {
    "CostLineItem": {
      "properties": {
        "category": {
          "pattern": "^(compute|storage|network|api|managed_service|third_party)$",
          "title": "Category",
          "type": "string"
        },
        "service": {
          "minLength": 1,
          "title": "Service",
          "type": "string"
        },
        "usage": {
          "minLength": 1,
          "title": "Usage",
          "type": "string"
        },
        "unit_cost": {
          "default": "",
          "title": "Unit Cost",
          "type": "string"
        },
        "monthly_cost": {
          "minimum": 0,
          "title": "Monthly Cost",
          "type": "number"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "category",
        "service",
        "usage",
        "monthly_cost"
      ],
      "title": "CostLineItem",
      "type": "object"
    },
    "CostRisk": {
      "properties": {
        "id": {
          "pattern": "^RISK-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "risk": {
          "minLength": 10,
          "title": "Risk",
          "type": "string"
        },
        "worst_case_monthly": {
          "minimum": 0,
          "title": "Worst Case Monthly",
          "type": "number"
        },
        "mitigation": {
          "minLength": 1,
          "title": "Mitigation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "component",
        "risk",
        "worst_case_monthly",
        "mitigation"
      ],
      "title": "CostRisk",
      "type": "object"
    },
    "CostTier": {
      "properties": {
        "tier": {
          "pattern": "^(launch|growth|scale)$",
          "title": "Tier",
          "type": "string"
        },
        "monthly_users": {
          "minimum": 0,
          "title": "Monthly Users",
          "type": "integer"
        },
        "monthly_requests": {
          "minimum": 0,
          "title": "Monthly Requests",
          "type": "integer"
        },
        "estimated_monthly_cost": {
          "minimum": 0,
          "title": "Estimated Monthly Cost",
          "type": "number"
        },
        "breakdown": {
          "items": {
            "$ref": "#/$defs/CostLineItem"
          },
          "minItems": 1,
          "title": "Breakdown",
          "type": "array"
        }
      },
      "required": [
        "tier",
        "monthly_users",
        "monthly_requests",
        "estimated_monthly_cost",
        "breakdown"
      ],
      "title": "CostTier",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "minLength": 50,
      "title": "Summary",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "cost_tiers": {
      "items": {
        "$ref": "#/$defs/CostTier"
      },
      "minItems": 1,
      "title": "Cost Tiers",
      "type": "array"
    },
    "cost_risks": {
      "items": {
        "$ref": "#/$defs/CostRisk"
      },
      "title": "Cost Risks",
      "type": "array"
    },
    "cost_optimizations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Cost Optimizations",
      "type": "array"
    },
    "free_tier_dependencies": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Free Tier Dependencies",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "cost_tiers",
    "recommendations"
  ],
  "title": "CostEstimate",
  "type": "object"
}
