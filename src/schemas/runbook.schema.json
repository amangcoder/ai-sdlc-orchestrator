{
  "$defs": {
    "IncidentProcedure": {
      "properties": {
        "id": {
          "pattern": "^INC-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "alert_name": {
          "minLength": 1,
          "title": "Alert Name",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "diagnosis": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 1,
          "title": "Diagnosis",
          "type": "array"
        },
        "resolution": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "minItems": 1,
          "title": "Resolution",
          "type": "array"
        },
        "escalation": {
          "minLength": 1,
          "title": "Escalation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "alert_name",
        "severity",
        "diagnosis",
        "resolution",
        "escalation"
      ],
      "title": "IncidentProcedure",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ],
      "title": "IssueSeverity",
      "type": "string"
    }
  },
  "properties": {
    "summary": {
      "minLength": 50,
      "title": "Summary",
      "type": "string"
    },
    "system_name": {
      "minLength": 1,
      "title": "System Name",
      "type": "string"
    },
    "deployment": {
      "additionalProperties": true,
      "title": "Deployment",
      "type": "object"
    },
    "incident_procedures": {
      "items": {
        "$ref": "#/$defs/IncidentProcedure"
      },
      "minItems": 1,
      "title": "Incident Procedures",
      "type": "array"
    },
    "maintenance_tasks": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Maintenance Tasks",
      "type": "array"
    },
    "key_contacts": {
      "additionalProperties": true,
      "title": "Key Contacts",
      "type": "object"
    },
    "dashboards_and_logs": {
      "additionalProperties": true,
      "title": "Dashboards And Logs",
      "type": "object"
    }
  },
  "required": [
    "summary",
    "system_name",
    "incident_procedures"
  ],
  "title": "Runbook",
  "type": "object"
}
