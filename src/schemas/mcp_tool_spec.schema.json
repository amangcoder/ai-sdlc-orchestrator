{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCPToolSpec",
  "description": "Formal specification of an MCP server's tool, resource, and prompt surface area.",
  "type": "object",
  "required": ["server_name", "version", "description", "sdk", "transport", "capabilities"],
  "properties": {
    "server_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20 },
    "sdk": { "type": "string", "enum": ["typescript", "python"] },
    "transport": {
      "type": "object",
      "required": ["type", "auth_method"],
      "properties": {
        "type": { "type": "string", "enum": ["stdio", "sse", "streamable_http"] },
        "auth_method": { "type": "string", "enum": ["none", "bearer", "oauth2", "api_key"] },
        "port": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "returns", "side_effects"],
        "properties": {
          "id": { "type": "string", "pattern": "^TOOL-\\d+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 10 },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "returns": { "type": "string", "minLength": 1 },
          "side_effects": { "type": "string", "enum": ["none", "read", "write", "external"] },
          "requires_auth": { "type": "boolean" },
          "rate_limit": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "uri_template", "name", "description", "mime_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^RES-\\d+$" },
          "uri_template": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 10 },
          "mime_type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^PROMPT-\\d+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 10 },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "error_handling": { "type": "object" }
  },
  "additionalProperties": false
}
