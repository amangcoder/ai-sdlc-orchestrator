{
  "$defs": {
    "MCPPromptDef": {
      "properties": {
        "id": {
          "pattern": "^PROMPT-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "arguments": {
          "items": {
            "$ref": "#/$defs/MCPToolParam"
          },
          "title": "Arguments",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "MCPPromptDef",
      "type": "object"
    },
    "MCPResourceDef": {
      "properties": {
        "id": {
          "pattern": "^RES-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "uri_template": {
          "minLength": 1,
          "title": "Uri Template",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "uri_template",
        "name",
        "description",
        "mime_type"
      ],
      "title": "MCPResourceDef",
      "type": "object"
    },
    "MCPToolDef": {
      "properties": {
        "id": {
          "pattern": "^TOOL-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/MCPToolParam"
          },
          "title": "Parameters",
          "type": "array"
        },
        "returns": {
          "minLength": 1,
          "title": "Returns",
          "type": "string"
        },
        "side_effects": {
          "pattern": "^(none|read|write|external)$",
          "title": "Side Effects",
          "type": "string"
        },
        "requires_auth": {
          "default": false,
          "title": "Requires Auth",
          "type": "boolean"
        },
        "rate_limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Limit"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "returns",
        "side_effects"
      ],
      "title": "MCPToolDef",
      "type": "object"
    },
    "MCPToolParam": {
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "title": "MCPToolParam",
      "type": "object"
    },
    "MCPTransportConfig": {
      "properties": {
        "type": {
          "pattern": "^(stdio|sse|streamable_http)$",
          "title": "Type",
          "type": "string"
        },
        "auth_method": {
          "pattern": "^(none|bearer|oauth2|api_key)$",
          "title": "Auth Method",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        }
      },
      "required": [
        "type",
        "auth_method"
      ],
      "title": "MCPTransportConfig",
      "type": "object"
    }
  },
  "properties": {
    "server_name": {
      "minLength": 1,
      "title": "Server Name",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "description": {
      "minLength": 20,
      "title": "Description",
      "type": "string"
    },
    "sdk": {
      "pattern": "^(typescript|python)$",
      "title": "Sdk",
      "type": "string"
    },
    "transport": {
      "$ref": "#/$defs/MCPTransportConfig"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/MCPToolDef"
      },
      "title": "Tools",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/MCPResourceDef"
      },
      "title": "Resources",
      "type": "array"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/MCPPromptDef"
      },
      "title": "Prompts",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "error_handling": {
      "additionalProperties": true,
      "title": "Error Handling",
      "type": "object"
    }
  },
  "required": [
    "server_name",
    "version",
    "description",
    "sdk",
    "transport",
    "capabilities"
  ],
  "title": "MCPToolSpec",
  "type": "object"
}
