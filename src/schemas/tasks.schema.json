{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasks",
  "description": "Task breakdown produced by the Architect agent",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "title", "description", "assigned_role", "dependencies", "acceptance_criteria", "files_to_modify", "estimated_complexity"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "assigned_role": {
            "type": "string",
            "enum": ["engineer", "qa"]
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TASK-\\d+$" }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "files_to_modify": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
