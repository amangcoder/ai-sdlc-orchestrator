{
  "$defs": {
    "Complexity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "Task": {
      "properties": {
        "task_id": {
          "pattern": "^TASK-\\d+$",
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "assigned_role": {
          "minLength": 1,
          "title": "Assigned Role",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "files_to_modify": {
          "items": {
            "type": "string"
          },
          "title": "Files To Modify",
          "type": "array"
        },
        "estimated_complexity": {
          "$ref": "#/$defs/Complexity"
        }
      },
      "required": [
        "task_id",
        "title",
        "description",
        "assigned_role",
        "acceptance_criteria",
        "estimated_complexity"
      ],
      "title": "Task",
      "type": "object"
    }
  },
  "properties": {
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "tasks"
  ],
  "title": "TaskList",
  "type": "object"
}
