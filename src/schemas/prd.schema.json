{
  "$defs": {
    "AcceptanceCriterion": {
      "properties": {
        "id": {
          "pattern": "^AC-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "criteria": {
          "minLength": 1,
          "title": "Criteria",
          "type": "string"
        }
      },
      "required": [
        "id",
        "criteria"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "must",
        "should",
        "could"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Requirement": {
      "properties": {
        "id": {
          "pattern": "^REQ-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        }
      },
      "required": [
        "id",
        "description",
        "priority"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "properties": {
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "overview": {
      "minLength": 50,
      "title": "Overview",
      "type": "string"
    },
    "goals": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Goals",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "acceptance_criteria": {
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/AcceptanceCriterion"
          }
        ]
      },
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    }
  },
  "required": [
    "title",
    "overview",
    "goals",
    "requirements",
    "acceptance_criteria"
  ],
  "title": "PRD",
  "type": "object"
}
