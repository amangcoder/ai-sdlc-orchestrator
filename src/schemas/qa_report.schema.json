{
  "$defs": {
    "IssueSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "QAIssue": {
      "properties": {
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "required": [
        "severity",
        "description"
      ],
      "title": "QAIssue",
      "type": "object"
    },
    "QAVerdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "QAVerdict",
      "type": "string"
    },
    "TestResults": {
      "properties": {
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "skipped"
      ],
      "title": "TestResults",
      "type": "object"
    }
  },
  "properties": {
    "test_results": {
      "$ref": "#/$defs/TestResults"
    },
    "lint_clean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lint Clean"
    },
    "type_check_clean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Type Check Clean"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/QAIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/QAVerdict"
    }
  },
  "required": [
    "test_results",
    "verdict"
  ],
  "title": "QAReport",
  "type": "object"
}
