{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Review",
  "description": "Code review report produced by the Reviewer agent",
  "type": "object",
  "required": ["verdict", "issues", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "request_changes", "pass", "fail", "pass_with_warnings"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "nit"] },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "description": "Overall assessment of the code changes"
    }
  },
  "additionalProperties": false
}
