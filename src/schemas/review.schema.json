{
  "$defs": {
    "IssueSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "ReviewIssue": {
      "properties": {
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "file": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "required": [
        "severity",
        "description"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ReviewVerdict": {
      "enum": [
        "approve",
        "reject",
        "request_changes",
        "pass_with_warnings"
      ],
      "title": "ReviewVerdict",
      "type": "string"
    }
  },
  "properties": {
    "verdict": {
      "$ref": "#/$defs/ReviewVerdict"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "summary": {
      "minLength": 20,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "summary"
  ],
  "title": "Review",
  "type": "object"
}
