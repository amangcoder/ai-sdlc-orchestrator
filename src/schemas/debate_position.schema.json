{
  "$defs": {
    "DebatePositionAgreement": {
      "properties": {
        "target_agent_id": {
          "minLength": 1,
          "title": "Target Agent Id",
          "type": "string"
        },
        "point_of_agreement": {
          "minLength": 10,
          "title": "Point Of Agreement",
          "type": "string"
        }
      },
      "required": [
        "target_agent_id",
        "point_of_agreement"
      ],
      "title": "DebatePositionAgreement",
      "type": "object"
    },
    "DebatePositionCritique": {
      "properties": {
        "target_agent_id": {
          "minLength": 1,
          "title": "Target Agent Id",
          "type": "string"
        },
        "critique": {
          "minLength": 10,
          "title": "Critique",
          "type": "string"
        },
        "severity": {
          "pattern": "^(fundamental|significant|minor)$",
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "target_agent_id",
        "critique",
        "severity"
      ],
      "title": "DebatePositionCritique",
      "type": "object"
    }
  },
  "description": "A single agent's position in one round of debate.",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "agent_role": {
      "pattern": "^(deep_researcher|brainstormer)$",
      "title": "Agent Role",
      "type": "string"
    },
    "round_number": {
      "minimum": 1,
      "title": "Round Number",
      "type": "integer"
    },
    "thesis": {
      "minLength": 50,
      "title": "Thesis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "risks_identified": {
      "items": {
        "type": "string"
      },
      "title": "Risks Identified",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    },
    "critiques_of_others": {
      "items": {
        "$ref": "#/$defs/DebatePositionCritique"
      },
      "title": "Critiques Of Others",
      "type": "array"
    },
    "agreements_with_others": {
      "items": {
        "$ref": "#/$defs/DebatePositionAgreement"
      },
      "title": "Agreements With Others",
      "type": "array"
    },
    "confidence": {
      "maximum": 100,
      "minimum": 0,
      "title": "Confidence",
      "type": "integer"
    },
    "evolved_from_previous": {
      "default": false,
      "title": "Evolved From Previous",
      "type": "boolean"
    },
    "evolution_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evolution Summary"
    }
  },
  "required": [
    "agent_id",
    "agent_role",
    "round_number",
    "thesis",
    "evidence",
    "recommendations",
    "confidence"
  ],
  "title": "DebatePosition",
  "type": "object"
}
