{
  "$defs": {
    "IssueSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "Threat": {
      "properties": {
        "id": {
          "pattern": "^THREAT-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "mitigation": {
          "minLength": 1,
          "title": "Mitigation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "severity",
        "mitigation"
      ],
      "title": "Threat",
      "type": "object"
    }
  },
  "properties": {
    "threats": {
      "items": {
        "$ref": "#/$defs/Threat"
      },
      "minItems": 1,
      "title": "Threats",
      "type": "array"
    },
    "attack_surface": {
      "minLength": 20,
      "title": "Attack Surface",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    },
    "verdict": {
      "enum": ["pass", "fail"],
      "default": "pass",
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "threats",
    "attack_surface",
    "recommendations"
  ],
  "title": "ThreatModel",
  "type": "object"
}
