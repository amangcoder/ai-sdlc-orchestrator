{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Plan",
  "description": "Engineering strategy and implementation plan produced by the Principal Engineer",
  "type": "object",
  "required": ["strategy", "implementation_order", "testing_strategy"],
  "properties": {
    "strategy": {
      "type": "string",
      "minLength": 20,
      "description": "Overall engineering approach"
    },
    "implementation_order": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["phase", "tasks"],
            "properties": {
              "phase": { "type": "string", "description": "Phase name/label" },
              "description": { "type": "string", "description": "What this phase accomplishes" },
              "tasks": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Task IDs included in this phase"
              },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Task IDs that must complete before this phase"
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "description": "Ordered list of implementation phases or steps"
    },
    "risk_areas": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["area", "risk"],
            "properties": {
              "area": { "type": "string", "description": "Area of concern" },
              "risk": { "type": "string", "description": "Description of the risk" },
              "mitigation": { "type": "string", "description": "How to mitigate the risk" }
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "Identified risks and concerns"
    },
    "testing_strategy": {
      "type": "string",
      "minLength": 10,
      "description": "How to test the implementation"
    }
  },
  "additionalProperties": false
}
