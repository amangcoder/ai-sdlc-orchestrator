{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Plan",
  "description": "Engineering strategy and implementation plan produced by the Principal Engineer",
  "type": "object",
  "required": ["strategy", "implementation_order", "risk_areas", "testing_strategy"],
  "properties": {
    "strategy": {
      "type": "string",
      "minLength": 20,
      "description": "Overall engineering approach"
    },
    "implementation_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["phase", "description"],
            "properties": {
              "phase": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "tasks": { "type": "array", "items": { "type": "string" } },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "Ordered list of implementation steps or phases"
    },
    "risk_areas": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["area", "risk", "mitigation"],
            "properties": {
              "area": { "type": "string", "minLength": 1 },
              "risk": { "type": "string", "minLength": 1 },
              "mitigation": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "Identified risks and concerns"
    },
    "testing_strategy": {
      "oneOf": [
        { "type": "string", "minLength": 10 },
        {
          "type": "object",
          "properties": {
            "unit": { "type": "string" },
            "integration": { "type": "string" },
            "e2e": { "type": "string" },
            "manual": { "type": "string" }
          },
          "additionalProperties": false
        }
      ],
      "description": "How to test the implementation"
    }
  },
  "additionalProperties": false
}
