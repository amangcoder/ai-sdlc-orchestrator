{
  "$defs": {
    "DebateConclusionDissent": {
      "properties": {
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "dissent": {
          "minLength": 1,
          "title": "Dissent",
          "type": "string"
        },
        "mediator_note": {
          "minLength": 1,
          "title": "Mediator Note",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "dissent",
        "mediator_note"
      ],
      "title": "DebateConclusionDissent",
      "type": "object"
    },
    "DebateConclusionRequirement": {
      "properties": {
        "requirement": {
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_agents": {
          "items": {
            "type": "string"
          },
          "title": "Source Agents",
          "type": "array"
        },
        "confidence": {
          "maximum": 100,
          "minimum": 0,
          "title": "Confidence",
          "type": "integer"
        }
      },
      "required": [
        "requirement",
        "rationale",
        "confidence"
      ],
      "title": "DebateConclusionRequirement",
      "type": "object"
    },
    "DebateConclusionRisk": {
      "properties": {
        "risk": {
          "minLength": 1,
          "title": "Risk",
          "type": "string"
        },
        "severity": {
          "pattern": "^(critical|high|medium|low)$",
          "title": "Severity",
          "type": "string"
        },
        "mitigation": {
          "minLength": 1,
          "title": "Mitigation",
          "type": "string"
        },
        "raised_by": {
          "items": {
            "type": "string"
          },
          "title": "Raised By",
          "type": "array"
        }
      },
      "required": [
        "risk",
        "severity",
        "mitigation"
      ],
      "title": "DebateConclusionRisk",
      "type": "object"
    },
    "DebateConclusionTension": {
      "properties": {
        "tension": {
          "minLength": 1,
          "title": "Tension",
          "type": "string"
        },
        "side_a": {
          "minLength": 1,
          "title": "Side A",
          "type": "string"
        },
        "side_b": {
          "minLength": 1,
          "title": "Side B",
          "type": "string"
        },
        "mediator_recommendation": {
          "minLength": 1,
          "title": "Mediator Recommendation",
          "type": "string"
        }
      },
      "required": [
        "tension",
        "side_a",
        "side_b",
        "mediator_recommendation"
      ],
      "title": "DebateConclusionTension",
      "type": "object"
    }
  },
  "description": "Mediator's final synthesis of the debate.",
  "properties": {
    "resolved_requirements": {
      "items": {
        "$ref": "#/$defs/DebateConclusionRequirement"
      },
      "minItems": 1,
      "title": "Resolved Requirements",
      "type": "array"
    },
    "unresolved_tensions": {
      "items": {
        "$ref": "#/$defs/DebateConclusionTension"
      },
      "title": "Unresolved Tensions",
      "type": "array"
    },
    "risk_assessment": {
      "items": {
        "$ref": "#/$defs/DebateConclusionRisk"
      },
      "title": "Risk Assessment",
      "type": "array"
    },
    "recommended_scope": {
      "minLength": 20,
      "title": "Recommended Scope",
      "type": "string"
    },
    "recommended_priorities": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommended Priorities",
      "type": "array"
    },
    "dissenting_opinions": {
      "items": {
        "$ref": "#/$defs/DebateConclusionDissent"
      },
      "title": "Dissenting Opinions",
      "type": "array"
    },
    "overall_confidence": {
      "maximum": 100,
      "minimum": 0,
      "title": "Overall Confidence",
      "type": "integer"
    },
    "rounds_conducted": {
      "minimum": 1,
      "title": "Rounds Conducted",
      "type": "integer"
    },
    "total_positions_evaluated": {
      "minimum": 1,
      "title": "Total Positions Evaluated",
      "type": "integer"
    }
  },
  "required": [
    "resolved_requirements",
    "recommended_scope",
    "recommended_priorities",
    "overall_confidence",
    "rounds_conducted",
    "total_positions_evaluated"
  ],
  "title": "DebateConclusion",
  "type": "object"
}
