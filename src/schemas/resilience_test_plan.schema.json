{
  "$defs": {
    "ChaosTestScenario": {
      "properties": {
        "id": {
          "pattern": "^CHAOS-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "pattern": "^(dependency_down|slow_dependency|partial_failure|resource_exhaustion|data_corruption|cascading_failure|network_partition|clock_skew)$",
          "title": "Category",
          "type": "string"
        },
        "failure_injected": {
          "minLength": 10,
          "title": "Failure Injected",
          "type": "string"
        },
        "affected_components": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Components",
          "type": "array"
        },
        "expected_behavior": {
          "minLength": 10,
          "title": "Expected Behavior",
          "type": "string"
        },
        "actual_behavior": {
          "default": "",
          "title": "Actual Behavior",
          "type": "string"
        },
        "severity_if_unhandled": {
          "$ref": "#/$defs/IssueSeverity",
          "default": "major"
        },
        "blast_radius": {
          "default": "",
          "title": "Blast Radius",
          "type": "string"
        },
        "remediation": {
          "minLength": 1,
          "title": "Remediation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "failure_injected",
        "affected_components",
        "expected_behavior",
        "remediation"
      ],
      "title": "ChaosTestScenario",
      "type": "object"
    },
    "FailureDomain": {
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "type": {
          "pattern": "^(database|cache|queue|api|network|disk|compute)$",
          "title": "Type",
          "type": "string"
        },
        "single_point_of_failure": {
          "default": false,
          "title": "Single Point Of Failure",
          "type": "boolean"
        },
        "current_protections": {
          "items": {
            "type": "string"
          },
          "title": "Current Protections",
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "domain",
        "type"
      ],
      "title": "FailureDomain",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "nit"
      ],
      "title": "IssueSeverity",
      "type": "string"
    }
  },
  "properties": {
    "summary": {
      "minLength": 50,
      "title": "Summary",
      "type": "string"
    },
    "overall_resilience": {
      "pattern": "^(robust|adequate|fragile|untested)$",
      "title": "Overall Resilience",
      "type": "string"
    },
    "failure_domains": {
      "items": {
        "$ref": "#/$defs/FailureDomain"
      },
      "minItems": 1,
      "title": "Failure Domains",
      "type": "array"
    },
    "test_scenarios": {
      "items": {
        "$ref": "#/$defs/ChaosTestScenario"
      },
      "minItems": 1,
      "title": "Test Scenarios",
      "type": "array"
    },
    "missing_patterns": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Missing Patterns",
      "type": "array"
    },
    "recovery_tests": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Recovery Tests",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "overall_resilience",
    "failure_domains",
    "test_scenarios",
    "recommendations"
  ],
  "title": "ResilienceTestPlan",
  "type": "object"
}
