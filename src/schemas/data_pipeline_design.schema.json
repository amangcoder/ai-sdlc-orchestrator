{
  "$defs": {
    "DataPipeline": {
      "properties": {
        "id": {
          "pattern": "^PIPE-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "pattern": "^(streaming|batch|hybrid)$",
          "title": "Type",
          "type": "string"
        },
        "source": {
          "additionalProperties": true,
          "title": "Source",
          "type": "object"
        },
        "transformations": {
          "items": {
            "$ref": "#/$defs/PipelineTransformation"
          },
          "title": "Transformations",
          "type": "array"
        },
        "destination": {
          "additionalProperties": true,
          "title": "Destination",
          "type": "object"
        },
        "freshness_requirement": {
          "pattern": "^(real_time|near_real_time|hourly|daily)$",
          "title": "Freshness Requirement",
          "type": "string"
        },
        "volume_estimate": {
          "default": "",
          "title": "Volume Estimate",
          "type": "string"
        },
        "error_handling": {
          "additionalProperties": true,
          "title": "Error Handling",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "freshness_requirement"
      ],
      "title": "DataPipeline",
      "type": "object"
    },
    "DataQualityRule": {
      "properties": {
        "id": {
          "pattern": "^DQ-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "pipeline": {
          "minLength": 1,
          "title": "Pipeline",
          "type": "string"
        },
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "enforcement": {
          "pattern": "^(block|warn|log)$",
          "title": "Enforcement",
          "type": "string"
        },
        "threshold": {
          "default": "",
          "title": "Threshold",
          "type": "string"
        }
      },
      "required": [
        "id",
        "pipeline",
        "rule",
        "enforcement"
      ],
      "title": "DataQualityRule",
      "type": "object"
    },
    "PipelineTransformation": {
      "properties": {
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "operation": {
          "pattern": "^(validate|filter|map|join|aggregate|enrich|deduplicate)$",
          "title": "Operation",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "default": "",
          "title": "Input Schema",
          "type": "string"
        },
        "output_schema": {
          "default": "",
          "title": "Output Schema",
          "type": "string"
        }
      },
      "required": [
        "step",
        "operation",
        "description"
      ],
      "title": "PipelineTransformation",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "minLength": 50,
      "title": "Summary",
      "type": "string"
    },
    "pipelines": {
      "items": {
        "$ref": "#/$defs/DataPipeline"
      },
      "minItems": 1,
      "title": "Pipelines",
      "type": "array"
    },
    "data_quality_rules": {
      "items": {
        "$ref": "#/$defs/DataQualityRule"
      },
      "title": "Data Quality Rules",
      "type": "array"
    },
    "infrastructure": {
      "additionalProperties": true,
      "title": "Infrastructure",
      "type": "object"
    },
    "data_lineage": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Data Lineage",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "pipelines",
    "recommendations"
  ],
  "title": "DataPipelineDesign",
  "type": "object"
}
